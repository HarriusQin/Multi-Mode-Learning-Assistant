# LLM 配置
LLM_API_KEY=your_api_key
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=your_model_name
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=10

# Embedding 配置
EMBED_API_KEY=your_api_key
EMBED_BASE_URL=http://localhost:1234/v1
EMBED_MODEL=your_embedding_model
EMBED_TIMEOUT=60.0
EMBED_N_DIMS=4096

# Reranker 配置
RERANK_API_KEY=your_api_key
RERANK_BASE_URL=http://localhost:8000/v1
RERANK_MODEL=your_reranker_model
RERANK_TIMEOUT=60.0

# 向量数据库配置
VECTOR_DB_PATH=knowledge.db

# Agent 配置
AGENT_MAX_LOOP=10
AGENT_MAX_MESSAGES=20

# 日志配置 (10=DEBUG, 20=INFO, 30=WARNING, 40=ERROR)
LOG_LEVEL=10
